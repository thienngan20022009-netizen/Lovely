<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lovely - Truyện tranh</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#fff8fc;color:#35283a;font-family:Arial,sans-serif}
header{position:sticky;top:0;background:white;padding:16px 7%;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 12px #0001}
.logo{font-size:26px;font-weight:bold;color:#c04486;text-decoration:none}
nav{display:flex;gap:20px}
nav a{color:#574b5b;text-decoration:none;font-weight:bold}
button{cursor:pointer}
.user-btn,.read-btn{background:#c04486;color:white;border:0;border-radius:20px;padding:10px 16px}
main{max-width:1100px;margin:28px auto;padding:0 20px}
.banner{background:linear-gradient(120deg,#794279,#d7659a);padding:28px;border-radius:15px;color:white}
.banner h1{margin:0 0 8px}
.title{font-size:22px;margin:28px 0 14px}
.categories{display:flex;gap:9px;flex-wrap:wrap}
.category{background:white;border:1px solid #edd5e3;border-radius:20px;padding:9px 15px;color:#65445b}
.category.active,.category:hover{background:#c04486;color:white}
.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.card{background:white;border-radius:12px;overflow:hidden;box-shadow:0 3px 14px #4d174010}
.cover{width:100%;height:220px;object-fit:cover;background:#eee}
.card-info{padding:12px}
.card h3{font-size:15px;margin:0 0 6px}
.genre{font-size:12px;color:#907f8d}
.card-actions{display:flex;gap:7px;margin-top:12px}
.card-actions button{flex:1;border:0;border-radius:7px;padding:8px}
.read-btn{border-radius:7px}
.save-btn{background:#f8e9f1;color:#9d326a}
.empty{background:white;padding:16px;border-radius:8px;color:#887887}
footer{text-align:center;background:#4b344b;color:#f6eaf3;padding:22px;line-height:1.8}
dialog{width:min(380px,92vw);border:0;border-radius:12px;padding:22px}
dialog::backdrop{background:#0008}
dialog input{width:100%;padding:11px;margin:7px 0;border:1px solid #ddd;border-radius:6px}
@media(max-width:800px){.grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:550px){header{padding:14px}.logo{font-size:21px}nav{gap:9px}nav a{font-size:12px}.grid{grid-template-columns:repeat(2,1fr)}.cover{height:190px}}
</style>
</head>
<body>

<header>
  <a class="logo" href="#">♡ Lovely</a>
  <nav>
    <a href="#home">Trang chính</a>
    <a href="#categories">Danh mục</a>
    <a href="#folder">Thư mục</a>
  </nav>
  <button class="user-btn" id="userButton">User</button>
</header>

<main id="home">
  <section class="banner">
    <h1>Chào mừng đến với Lovely</h1>
    <p>Khám phá truyện tranh và lưu những bộ truyện bạn yêu thích.</p>
  </section>

  <h2 class="title" id="categories">Danh mục</h2>
  <div class="categories" id="categoryButtons"></div>

  <h2 class="title" id="listTitle">Truyện hot</h2>
  <div class="grid" id="comicList"></div>

  <h2 class="title" id="folder">Thư mục truyện đã lưu</h2>
  <div class="grid" id="savedList"></div>
</main>

<footer>
  <strong>Trường THPT Nguyễn Trải</strong><br>
  144, QL22 Trảng Bảng, Tây Ninh<br>
  Lớp 12A11_Tổ 4
</footer>

<dialog id="accountDialog">
  <h2>Tạo tài khoản</h2>
  <form id="accountForm">
    <input id="userName" placeholder="Tên của bạn" required>
    <input id="userEmail" type="email" placeholder="Email" required>
    <input id="userPassword" type="password" placeholder="Mật khẩu" required>
    <button class="user-btn">Đăng ký</button>
    <button type="button" id="closeDialog">Đóng</button>
  </form>
</dialog>

<script>
const truyens = [
  {ten:"Detective Conan", theloai:"Trinh thám", anh:"https://i.pinimg.com/736x/23/6b/8d/236b8d5ce29ea4e637dc3943bed3a28c.jpg"},
  {ten:"One Piece", theloai:"Phiêu lưu", anh:"https://i.pinimg.com/736x/73/98/15/73981585bbead4a3aa37b934b346fc92.jpg"},
  {ten:"Dragon Ball", theloai:"Hành động", anh:"https://i.pinimg.com/1200x/b4/0c/30/b40c30aaae4585c6a4ebbdc95e93465a.jpg"},
  {ten:"Hunter X ", theloai:"Phiêu lưu", anh:"https://i.pinimg.com/1200x/d4/f0/1b/d4f01be158eb69460177ac77c18ed32b.jpg"},
  {ten:"Kimetsu no Yaiba", theloai:"Hành động", anh:"https://i.pinimg.com/736x/71/c5/24/71c524fa316265d161a8a7753a232228.jpg"},
  {ten:"Jujutsu Kaisen", theloai:"Hành động", anh:"https://i.pinimg.com/1200x/2a/1c/ea/2a1cea5bf5c0cb64d2a61a8f748cbf29.jpg"},
  {ten:"Monster", theloai:"Trinh thám", anh:"https://i.pinimg.com/1200x/7d/96/d8/7d96d871d5369cc0eacca83d243b5fe3.jpg"},
  {ten:"Attack on Titan", theloai:"Hành động", anh:"https://i.pinimg.com/736x/0f/6e/9a/0f6e9a76858c7640c65f86936499864a.jpg"},
  {ten:"Naruto", theloai:"Phiêu lưu", anh:"https://i.ebayimg.com/images/g/V70AAeSwAV9p2k91/s-l1200.jpg"},
  {ten:"Spy x Family", theloai:"Hài hước", anh:"https://i.pinimg.com/736x/94/e9/c7/94e9c7634bfbdf892b09d8d5b0172341.jpg"},
  {ten:"Nichijou", theloai:"Hài hước", anh:"https://i.pinimg.com/1200x/68/c7/ce/68c7ce97c5fa5c9083ca5ae8c25b0d55.jpg"},
  {ten:"Sakamoto Days", theloai:"Hành động", anh:"https://i.pinimg.com/736x/b4/14/36/b41436c976680dd3ca436b768411b8fd.jpg"},
  {ten:"Sakamoto Desu ga", theloai:"Hài hước", anh:"https://i.pinimg.com/1200x/56/b2/bd/56b2bd879794e9b6000e2c4159bc79f9.jpg"},
  {ten:"Sakamoto Desu ga", theloai:"Hài hước", anh:"https://i.pinimg.com/1200x/56/b2/bd/56b2bd879794e9b6000e2c4159bc79f9.jpg"},
  {ten:"Their Story", theloai:"Hài hước", anh:"https://i.pinimg.com/1200x/b7/a0/9b/b7a09bc00b808220fe5e2013dadad363.jpg"},
  {ten:"She Is Still Cute Today", theloai:"Hài hước", anh:"https://i.pinimg.com/1200x/22/f2/21/22f2219bcdd7bfe4b07fd53c7d7cadec.jpg"},
  ];

let daLuu = JSON.parse(localStorage.getItem("lovelyTruyenDaLuu") || "[]");
let theLoaiDangChon = "Tất cả";

function hienTruyen() {
  const danhSach = truyens.filter(t =>
    theLoaiDangChon === "Tất cả" || t.theloai === theLoaiDangChon
  );

  document.getElementById("comicList").innerHTML = danhSach.map(t => `
    <article class="card">
      <img class="cover" src="${t.anh}" alt="Bìa truyện ${t.ten}">
      <div class="card-info">
        <h3>${t.ten}</h3>
        <span class="genre">${t.theloai}</span>
        <div class="card-actions">
          <button class="read-btn" onclick="xemTruyen('${t.ten}')">Xem</button>
          <button class="save-btn" onclick="luuTruyen('${t.ten}')">
            ${daLuu.includes(t.ten) ? "Đã lưu" : "Lưu truyện"}
          </button>
        </div>
      </div>
    </article>
  `).join("");

  const truyenDaLuu = truyens.filter(t => daLuu.includes(t.ten));
  document.getElementById("savedList").innerHTML = truyenDaLuu.length
    ? truyenDaLuu.map(t => `
      <article class="card">
        <img class="cover" src="${t.anh}" alt="Bìa truyện ${t.ten}">
        <div class="card-info">
          <h3>${t.ten}</h3>
          <span class="genre">${t.theloai}</span>
          <div class="card-actions">
            <button class="save-btn" onclick="luuTruyen('${t.ten}')">Bỏ lưu</button>
          </div>
        </div>
      </article>
    `).join("")
    : '<p class="empty">Bạn chưa lưu truyện nào.</p>';
}

function luuTruyen(ten) {
  daLuu = daLuu.includes(ten)
    ? daLuu.filter(t => t !== ten)
    : [...daLuu, ten];
  localStorage.setItem("lovelyTruyenDaLuu", JSON.stringify(daLuu));
  hienTruyen();
}

function xemTruyen(ten) {
  alert("Bạn đã chọn truyện: " + ten);
}

const theLoais = ["Tất cả", "Hành động", "Trinh thám", "Phiêu lưu", "Hài hước"];
document.getElementById("categoryButtons").innerHTML = theLoais.map(t =>
  `<button class="category ${t === "Tất cả" ? "active" : ""}"
  onclick="chonTheLoai('${t}', this)">${t}</button>`
).join("");

function chonTheLoai(theLoai, nut) {
  theLoaiDangChon = theLoai;
  document.querySelectorAll(".category").forEach(n => n.classList.remove("active"));
  nut.classList.add("active");
  document.getElementById("listTitle").textContent =
    theLoai === "Tất cả" ? "Truyện hot" : "Truyện " + theLoai;
  hienTruyen();
}

document.getElementById("userButton").onclick = () =>
  document.getElementById("accountDialog").showModal();

document.getElementById("closeDialog").onclick = () =>
  document.getElementById("accountDialog").close();

document.getElementById("accountForm").onsubmit = function(event) {
  event.preventDefault();
  const ten = document.getElementById("userName").value;
  localStorage.setItem("lovelyUser", ten);
  document.getElementById("userButton").textContent = ten;
  document.getElementById("accountDialog").close();
};

const tenNguoiDung = localStorage.getItem("lovelyUser");
if (tenNguoiDung) document.getElementById("userButton").textContent = tenNguoiDung;

hienTruyen();
</script>
</body>
</html>
